DOMAIN=domus.example.com
DB_NAME=domus
DB_USER=domus_app
DB_PASSWORD=replace_with_a_long_random_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_password
SESSION_SECRET=replace_with_at_least_32_random_characters
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=domus@example.com
SMTP_PASSWORD=replace_me
SMTP_FROM=Domus <no-reply@example.com>
APP_IMAGE=domus-app:latest
APP_RELEASE=domus-2.2.0
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
BETA_PUBLISHING_REQUIRED=true
BETA_MAX_PUBLISHED_PER_OWNER=20
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
RESTIC_REPOSITORY=s3:https://s3.example.com/domus-backups
RESTIC_PASSWORD=replace_with_a_long_backup_encryption_password
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
